# ==========================================
# Configuración de MoodleAssist-AI
# ==========================================

# Clave API de Groq (Obtén la tuya en https://console.groq.com/keys)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# Modelo Groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT=45.0
GROQ_MAX_RETRIES=3

# Configuración del Navegador (nodriver / CDP)
HEADLESS=false
CHROME_USER_DATA_DIR=./chrome_profile
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Delays y Simulación de Tecleo Humano
HUMAN_TYPING=true
HUMAN_DELAY_MIN=0.4
HUMAN_DELAY_MAX=1.0
OPTION_DELAY_MIN=0.8
OPTION_DELAY_MAX=2.0
TYPING_SPEED_MIN=0.04
TYPING_SPEED_MAX=0.10

# URL de Moodle opcional
# MOODLE_URL=https://campus.tuuniversidad.edu.co/

