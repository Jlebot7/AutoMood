# ==========================================
# Configuración de MoodleAssist-AI
# ==========================================

# Clave API de Groq (Obtén la tuya en https://console.groq.com/keys)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# Modelo Groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT=45.0
GROQ_MAX_RETRIES=3

# Configuración del Navegador (nodriver / CDP)
HEADLESS=false
CHROME_USER_DATA_DIR=./chrome_profile
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Delays y Simulación de Tecleo Humano
HUMAN_TYPING=true
HUMAN_DELAY_MIN=0.4
HUMAN_DELAY_MAX=1.0
OPTION_DELAY_MIN=0.8
OPTION_DELAY_MAX=2.0
TYPING_SPEED_MIN=0.04
TYPING_SPEED_MAX=0.10

# Transcripción de Audio con Whisper (Listening / Audios de Moodle)
ENABLE_AUDIO_TRANSCRIPTION=true
WHISPER_PROVIDER=auto       # auto, groq, openai, local (faster-whisper)
WHISPER_MODEL=whisper-large-v3

# Reconocimiento Óptico de Caracteres (OCR / Visión para imágenes de preguntas)
ENABLE_IMAGE_OCR=true
OCR_PROVIDER=auto          # auto, easyocr, groq_vision, openai_vision
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
OCR_LANGUAGES=es,en

# Clave API de OpenAI (Opcional, solo si usas WHISPER_PROVIDER=openai o OCR_PROVIDER=openai_vision)
# OPENAI_API_KEY=sk-...

# URL de Moodle opcional
# MOODLE_URL=https://campus.tuuniversidad.edu.co/

