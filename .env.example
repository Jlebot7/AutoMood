# ==========================================
# Configuración de MoodleAssist-AI (AutoMood)
# ==========================================

# Clave API de Groq (Obtén la tuya en https://console.groq.com/keys)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# Modelo Groq (Recomendado: llama-3.3-70b-versatile o llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT=45.0
GROQ_MAX_RETRIES=3

# Modelo Local de Respaldo (Fallback automático cuando Groq falle, exceda cuota o no haya red)
ENABLE_LOCAL_FALLBACK=true
LOCAL_MODEL_PROVIDER=auto           # auto (detecta Ollama con GPU primero, luego Transformers), ollama, transformers
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct # Modelo HuggingFace (ej. Qwen/Qwen2.5-1.5B-Instruct o Qwen/Qwen2.5-0.5B-Instruct)
OLLAMA_MODEL_ID=qwen2.5:1.5b       # Modelo Ollama con aceleración GPU (ej. qwen2.5:1.5b o qwen2.5:0.5b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_DEVICE=auto             # auto, cuda, cpu
LOCAL_MODEL_MAX_NEW_TOKENS=1024

# Configuración del Navegador (nodriver / CDP)
HEADLESS=false
CHROME_USER_DATA_DIR=./chrome_profile
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Delays y Simulación de Tecleo Humano
HUMAN_TYPING=true
HUMAN_DELAY_MIN=0.4
HUMAN_DELAY_MAX=1.0
OPTION_DELAY_MIN=0.8
OPTION_DELAY_MAX=2.0
TYPING_SPEED_MIN=0.04
TYPING_SPEED_MAX=0.10

# Transcripción de Audio con Whisper (Listening / Audios de Moodle)
ENABLE_AUDIO_TRANSCRIPTION=true
WHISPER_PROVIDER=auto       # auto, groq, openai, local (faster-whisper)
WHISPER_MODEL=whisper-large-v3

# Reconocimiento Óptico de Caracteres (OCR / Visión para imágenes de preguntas)
ENABLE_IMAGE_OCR=true
OCR_PROVIDER=easyocr        # easyocr (local, recomendado), openai_vision
OCR_LANGUAGES=es,en

# Clave API de OpenAI (Opcional, solo si usas WHISPER_PROVIDER=openai o OCR_PROVIDER=openai_vision)
# OPENAI_API_KEY=sk-...

# URL de Moodle opcional
# MOODLE_URL=https://campus.tuuniversidad.edu.co/
